# SPDX-License-Identifier: MIT

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable GPIO
CONFIG_GPIO=y

# Enable Underglow
CONFIG_ZMK_RGB_UNDERGLOW=y
CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=y
CONFIG_ZMK_RGB_UNDERGLOW_ON_START=n

# Enable pinctrl
CONFIG_PINCTRL=y

# Enable I2C
CONFIG_I2C=y
CONFIG_I2C_NRFX=y

# Enable battery monitoring (ZMK)
CONFIG_ZMK_BATTERY=y
CONFIG_ZMK_MAX17048=y

# External RTC
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=n
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_50PPM=y

# Build uf2
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

# Enable ZMK Studio (full RPC + settings storage for runtime combos)
CONFIG_ZMK_STUDIO=y
CONFIG_ZMK_STUDIO_LOCKING=n
CONFIG_ZMK_STUDIO_RPC=y
CONFIG_ZMK_KEYMAP_SETTINGS_STORAGE=y
CONFIG_ZMK_BEHAVIOR_METADATA=y
CONFIG_ZMK_BEHAVIOR_LOCAL_IDS=y

# USB CDC-ACM for ZMK Studio RPC
CONFIG_USB_CDC_ACM=y
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_UART_LINE_CTRL=y

# Enable sleep, default set to 30 min (defined in ms)
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=1800000

# === WS2812 RGB LED Widget (single LED, all status sharing) ===
# Module: https://github.com/caksoylar/zmk-rgbled-widget
# Status plan: 蓝=蓝牙 / 绿=正常态 / 红=警告充电 / 黄=FN层 / 白=Caps
CONFIG_RGBLED_WIDGET=y
CONFIG_RGBLED_WIDGET_WS2812=y
CONFIG_RGBLED_WIDGET_LED_COUNT=1
CONFIG_RGBLED_WIDGET_SPATIAL_MAPPING=n
CONFIG_RGBLED_WIDGET_ANIMATIONS=y
CONFIG_RGBLED_WIDGET_LED_SHARING=y
CONFIG_RGBLED_WIDGET_BRIGHTNESS=128
CONFIG_RGBLED_WIDGET_SHARE_TIMEOUT_MS=500

# Battery status colors (high=green, medium=yellow, low=critical=red)
# Color values: 0=black 1=red 2=green 3=yellow 4=blue 5=magenta 6=cyan 7=white
CONFIG_RGBLED_WIDGET_BATTERY_LEVEL_HIGH=80
CONFIG_RGBLED_WIDGET_BATTERY_LEVEL_LOW=20
CONFIG_RGBLED_WIDGET_BATTERY_LEVEL_CRITICAL=5
CONFIG_RGBLED_WIDGET_BATTERY_COLOR_HIGH=2
CONFIG_RGBLED_WIDGET_BATTERY_COLOR_MEDIUM=3
CONFIG_RGBLED_WIDGET_BATTERY_COLOR_LOW=1
CONFIG_RGBLED_WIDGET_BATTERY_COLOR_CRITICAL=1
# Widget charging color = red (custom unit60_charger.c overrides with red solid,
# this keeps consistency if widget charging state triggers on its own)
CONFIG_RGBLED_WIDGET_BATTERY_COLOR_CHARGING=1

# Connectivity: all BLE states = blue, USB indicator disabled (charger handles plug-in)
CONFIG_RGBLED_WIDGET_CONN_BLINK_MS=3000
CONFIG_RGBLED_WIDGET_CONN_SHOW_USB=n
CONFIG_RGBLED_WIDGET_CONN_COLOR_CONNECTED=4
CONFIG_RGBLED_WIDGET_CONN_COLOR_ADVERTISING=4
CONFIG_RGBLED_WIDGET_CONN_COLOR_DISCONNECTED=4
CONFIG_RGBLED_WIDGET_CONN_COLOR_USB=2

# Layer colors: base=off, all FN layers=yellow (constant on while active)
CONFIG_RGBLED_WIDGET_SHOW_LAYER_COLORS=y
CONFIG_RGBLED_WIDGET_LAYER_0_COLOR=0
CONFIG_RGBLED_WIDGET_LAYER_1_COLOR=3
CONFIG_RGBLED_WIDGET_LAYER_2_COLOR=3
CONFIG_RGBLED_WIDGET_LAYER_3_COLOR=3

# Caps Lock indicator (default white)
CONFIG_RGBLED_WIDGET_SHOW_CAPSLOCK=y
