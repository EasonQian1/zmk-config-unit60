/*
 * Copyright (c) 2025 Eason
 *
 * SPDX-License-Identifier: MIT
 *
 * Matrix transform for unit60 rev_e (62-key 65% layout)
 * Diode direction: col2row (unchanged)
 *
 * Columns: COL0=P1.10 COL1=P0.03 COL2=P0.04 COL3=P0.28
 *          COL4=P1.06 COL5=P0.10 COL6=P1.02
 * Rows:    ROW0=P0.02 ROW1=P0.29 ROW2=P0.31 ROW3=P1.00
 *          ROW4=P0.26 ROW5=P0.22 ROW6=P0.08 ROW7=P0.09
 *          ROW8=P1.04 ROW9=P1.11
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    default_transform: transforms {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <10>;

        map = <
            /* Row 1: 15 keys (Esc, 1-0, -, =, BkSp, Del) */
            RC(0,0) RC(1,0) RC(0,1) RC(1,1) RC(0,2) RC(1,2) RC(0,3) RC(1,3) RC(0,4) RC(1,4) RC(0,5) RC(1,5) RC(0,6) RC(1,6) RC(3,6)

            /* Row 2: 14 keys (Tab, Q-P, [, ], \) */
            RC(2,0) RC(3,0) RC(2,1) RC(3,1) RC(2,2) RC(3,2) RC(2,3) RC(3,3) RC(2,4) RC(3,4) RC(2,5) RC(3,5) RC(5,6) RC(2,6)

            /* Row 3: 13 keys (Caps, A-L, ;, ', Enter) */
            RC(4,0) RC(5,0) RC(4,1) RC(5,1) RC(4,2) RC(5,2) RC(4,3) RC(5,3) RC(4,4) RC(5,4) RC(4,5) RC(5,5) RC(7,6)

            /* Row 4: 12 keys (Shift, Z-M, ,, ., /, Shift) */
            RC(6,0) RC(6,1) RC(7,1) RC(6,2) RC(7,2) RC(6,3) RC(7,3) RC(6,4) RC(7,4) RC(6,5) RC(7,5) RC(8,6)

            /* Row 5: 1 key (Up arrow) */
            RC(6,6)

            /* Row 6: 7 keys (Ctrl, Alt, Space, FN, Left, Down, Right) */
            RC(8,0) RC(9,0) RC(8,3) RC(8,1) RC(9,4) RC(8,5) RC(9,5)
        >;
    };
};
